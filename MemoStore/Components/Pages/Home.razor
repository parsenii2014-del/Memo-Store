@page "/"

<PageTitle>MEMO Store</PageTitle>

<div class="store-page">

    <header class="store-header">

        <a href="/" class="header-logo">
            MEMO <span>Store</span>
        </a>

    </header>


    <!-- CX08 PRO MAX -->
    @if (Products.CX08 > 0)
    {
        <Memo Image="CX08PRO.png"
              Title="MEMO CX08 Pro Max"
              Price="800"
              OrderLink="/order"
              CharacteristicsLink="/characteristics" />
    }


    <!-- CX20 -->
    @if (Products.CX20 > 0)
    {
        <Memo Image="CX20.png"
              Title="MEMO CX20"
              Price="625"
              OrderLink="/order/cx20"
              CharacteristicsLink="/characteristics/cx20" />
    }


    <!-- CX14 -->
    @if (Products.CX14 > 0)
    {
        <Memo Image="CX14.png"
              Title="MEMO CX14"
              Price="850"
              OrderLink="/order/cx14"
              CharacteristicsLink="/characteristics/cx14" />
    }


    <section class="bottom-section">

        <div class="section-title">
            MEMO Store
        </div>

        <div class="section-subtitle">
            Потужні кулери для смартфонів
        </div>

    </section>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
    }

    .store-page {
        width: 100%;
        min-height: 100vh;
        background: #07070b;
        color: white;
    }


    /* HEADER */

    .store-header {
        width: 100%;
        height: 78px;
        display: flex;
        align-items: center;
        padding: 0 5%;
        background: rgba(7, 7, 11, 0.95);
        border-bottom: 1px solid #25212f;
    }

    .header-logo {
        color: white;
        text-decoration: none;
        font-size: 28px;
        font-weight: 900;
    }

        .header-logo span {
            color: #a855f7;
        }


    /* PRODUCT */

    .product-section {
        width: 100%;
        min-height: calc(100vh - 78px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 40px;
        padding: 70px 5%;
        background: radial-gradient( circle at 78% 50%, #421675 0%, #171020 25%, #0b0a10 55%, #07070b 100% );
        border-top: 1px solid #211b29;
    }


    /* INFO */

    .product-info {
        width: 100%;
        max-width: 700px;
        padding-left: 2%;
    }

    .product-brand {
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 35px;
    }

        .product-brand span {
            color: #a855f7;
        }

    .product-info h1 {
        margin: 0;
        font-size: clamp(50px, 5.5vw, 90px);
        line-height: 0.95;
        font-weight: 500;
        letter-spacing: -3px;
    }

    .product-price {
        margin-top: 32px;
        font-size: 58px;
        line-height: 1;
        font-weight: 900;
    }


    /* BUTTONS */

    .product-buttons {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 42px;
    }

    .buy-button,
    .characteristics-button {
        min-height: 70px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 30px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 17px;
        font-weight: 900;
        transition: 0.2s;
    }

    .buy-button {
        background: #a855f7;
        color: white !important;
    }

        .buy-button:hover {
            background: #9333ea;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px #8b3dd955;
        }

    .characteristics-button {
        background: transparent;
        color: white !important;
        border: 1px solid #a855f7;
    }

        .characteristics-button:hover {
            background: #1d1328;
            transform: translateY(-2px);
        }


    /* IMAGE */

    .product-image {
        width: 100%;
        height: 600px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .product-image img {
            display: block;
            width: 100%;
            height: 100%;
            max-width: 700px;
            max-height: 600px;
            object-fit: contain;
            border-radius: 20px;
            filter: drop-shadow(0 0 55px #8b3dd966);
        }


    /* BOTTOM */

    .bottom-section {
        padding: 65px 20px;
        text-align: center;
        background: #09090e;
        border-top: 1px solid #25212f;
    }

    .section-title {
        font-size: 30px;
        font-weight: 900;
        color: #a855f7;
    }

    .section-subtitle {
        margin-top: 10px;
        color: #888;
        font-size: 17px;
    }


    /* TABLET */

    @@media (max-width: 900px) {

        .product-section {
            grid-template-columns: 1fr;
            min-height: auto;
            padding: 60px 7%;
            gap: 30px;
        }

        .product-image {
            order: -1;
            height: 450px;
        }

        .product-info {
            padding-left: 0;
        }

            .product-info h1 {
                font-size: 60px;
            }
    }


    /* MOBILE */

    @@media (max-width: 600px) {

        .store-header {
            height: 70px;
            padding: 0 20px;
        }

        .header-logo {
            font-size: 23px;
        }

        .product-section {
            padding: 45px 20px;
        }

        .product-image {
            height: 330px;
        }

        .product-info h1 {
            font-size: 48px;
            letter-spacing: -2px;
        }

        .product-brand {
            font-size: 24px;
            margin-bottom: 25px;
        }

        .product-price {
            font-size: 46px;
        }

        .product-buttons {
            flex-direction: column;
            align-items: stretch;
        }

        .buy-button,
        .characteristics-button {
            width: 100%;
        }
    }

</style>