@page "/shop"

<PageTitle>MEMO CX08 Pro Max — MEMO Store</PageTitle>

<div class="shop-page">

    <div class="shop-container">

        <a href="/" class="back-btn">
            ← НАЗАД
        </a>

        <div class="product-layout">

            <!-- КАРТИНКА -->
            <div class="product-image-box">
                <img src="photo_2026-09-15_23-53-25.jpg"
                     alt="MEMO CX08 Pro Max" />
            </div>

            <!-- ИНФОРМАЦИЯ -->
            <div class="product-info">

                <div class="product-brand">
                    MEMO Store
                </div>

                <h1>
                    MEMO CX08
                    <br />
                    <span>Pro Max</span>
                </h1>

                <div class="product-subtitle">
                    23W • RGB • Pro Max
                </div>

                <p class="product-description">
                    Потужний кулер для смартфона,
                    створений для ігор та високих навантажень.
                </p>

                <div class="price">
                    800 грн
                </div>

                <div class="wholesale">
                    Від 3 шт — <b>700 грн/шт</b>
                </div>

                <div class="buttons">

                    <a href="/characteristics"
                       class="characteristics-btn">
                        ХАРАКТЕРИСТИКИ
                    </a>

                    <a href="/order"
                       class="order-btn">
                        ЗАМОВИТИ ЗАРАЗ
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #09060d;
        color: white;
        font-family: Arial, Helvetica, sans-serif;
    }

    .shop-page {
        min-height: 100vh;
        background: radial-gradient( circle at 75% 45%, rgba(139, 61, 217, 0.18), transparent 35% ), #09060d;
        padding: 40px 25px;
    }

    .shop-container {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
    }

    .back-btn {
        display: inline-block;
        color: #aaa;
        text-decoration: none;
        font-size: 15px;
        margin-bottom: 50px;
        transition: 0.2s;
    }

        .back-btn:hover {
            color: #a855f7;
        }

    .product-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 80px;
    }

    /* =========================
           КАРТИНКА
           ========================= */

    .product-image-box {
        width: 100%;
        min-height: 520px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 30px;
        background: radial-gradient( circle, rgba(168, 85, 247, 0.22), rgba(20, 10, 30, 0.5) 55%, rgba(10, 7, 14, 0.9) );
        border: 1px solid rgba(168, 85, 247, 0.3);
        box-shadow: 0 0 80px rgba(168, 85, 247, 0.15);
    }

        .product-image-box img {
            max-width: 90%;
            max-height: 480px;
            object-fit: contain;
            display: block;
        }

    /* =========================
           ИНФОРМАЦИЯ
           ========================= */

    .product-brand {
        color: #a855f7;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }

    .product-info h1 {
        margin: 0;
        font-size: 64px;
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -2px;
    }

        .product-info h1 span {
            color: #a855f7;
        }

    .product-subtitle {
        margin-top: 25px;
        color: #aaa;
        font-size: 18px;
    }

    .product-description {
        max-width: 520px;
        color: #aaa;
        font-size: 17px;
        line-height: 1.6;
        margin-top: 25px;
    }

    .price {
        margin-top: 30px;
        font-size: 42px;
        font-weight: 800;
    }

    .wholesale {
        margin-top: 8px;
        color: #a855f7;
        font-size: 17px;
    }

    .buttons {
        display: flex;
        gap: 15px;
        margin-top: 35px;
        flex-wrap: wrap;
    }

    .characteristics-btn,
    .order-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 0 25px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        transition: 0.2s;
    }

    .characteristics-btn {
        color: white;
        border: 1px solid #a855f7;
        background: transparent;
    }

        .characteristics-btn:hover {
            background: rgba(168, 85, 247, 0.15);
            transform: translateY(-2px);
        }

    .order-btn {
        color: white;
        background: #a855f7;
        border: 1px solid #a855f7;
        box-shadow: 0 0 25px rgba(168, 85, 247, 0.25);
    }

        .order-btn:hover {
            background: #9333ea;
            transform: translateY(-2px);
        }

    /* =========================
           ТЕЛЕФОН
           ========================= */

    @@media (max-width: 900px) {

        .product-layout {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .product-image-box {
            min-height: 400px;
        }

        .product-info h1 {
            font-size: 50px;
        }
    }

    @@media (max-width: 600px) {

        .shop-page {
            padding: 25px 15px;
        }

        .back-btn {
            margin-bottom: 30px;
        }

        .product-image-box {
            min-height: 300px;
            border-radius: 20px;
        }

            .product-image-box img {
                max-height: 280px;
            }

        .product-info h1 {
            font-size: 42px;
        }

        .product-description {
            font-size: 15px;
        }

        .price {
            font-size: 35px;
        }

        .buttons {
            flex-direction: column;
        }

        .characteristics-btn,
        .order-btn {
            width: 100%;
        }
    }

</style>